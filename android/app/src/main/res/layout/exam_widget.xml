<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- 标题 -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📚 考试倒计时"
        android:textSize="14sp"
        android:textColor="#333333"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <!-- 考试1 -->
    <LinearLayout
        android:id="@+id/exam_item_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/exam_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#555555"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/exam_countdown_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#E53935"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 考试2 -->
    <LinearLayout
        android:id="@+id/exam_item_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/exam_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#555555"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/exam_countdown_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#E53935"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 考试3 -->
    <LinearLayout
        android:id="@+id/exam_item_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/exam_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textColor="#555555"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/exam_countdown_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#E53935"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 无考试提示 -->
    <TextView
        android:id="@+id/no_exam_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="暂无考试安排"
        android:textSize="12sp"
        android:textColor="#999999"
        android:gravity="center"
        android:paddingTop="16dp"
        android:visibility="visible" />

</LinearLayout>
